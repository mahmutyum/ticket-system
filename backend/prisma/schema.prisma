generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUM'LAR ====================
//
// Bu değerler eskiden düz String'di ve geçerli küme yalnızca Zod şemalarında
// yaşıyordu: veritabanı seviyesinde hiçbir koruma yoktu ve derleyici de yardım
// etmiyordu (her kontrol ham string literal'di). `config/constants.ts` bu
// enum'lardan TÜRETİLİR — geçerli değerlerin tek doğruluk kaynağı burasıdır.
//
// Yeni bir değer eklerken: önce buraya ekle, `prisma migrate dev` çalıştır,
// sonra etiketini `config/constants.ts`'e yaz. Zod şemaları `z.nativeEnum` ile
// otomatik uyar.
//
// NOT: `Notification.channel` bilinçli olarak String bırakıldı — e-posta/SMS
// şablonlarının `slug`'ı ile eşleşir ve şablonlar veritabanından yönetilir;
// yeni bir şablon eklemek migration gerektirmemeli.

enum StaffRole {
  admin
  it_manager
  it_staff
}

enum TicketStatus {
  open
  in_progress
  waiting_user_response
  waiting_other_department
  topic_transferred
  process_outside_it
  on_hold
  resolved
  closed
}

/// Ticket ve görevler için ORTAK öncelik sözlüğü.
/// Görevler eskiden 'urgent' kullanıyordu; aynı kavramın iki sözcüğü olmasın
/// diye 'critical'a hizalandı.
enum Priority {
  low
  medium
  high
  critical
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum OnsiteType {
  come_to_it_room
  meeting_room
  visit_employee
}

enum OnsiteStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum NotificationType {
  email
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum CompanyGroupType {
  call_center
  corporate
  warehouse
  retail
}

enum IdentityProviderType {
  oidc
  saml
  ldap
}

enum WebhookKind {
  generic
  teams
  slack
}

enum MailboxProvider {
  imap
  microsoft365
  gmail
}

enum CustomFieldType {
  text
  number
  select
  phone
  url
  email
  textarea
}

// ==================== ŞİRKET & LOKASYON ====================

model Company {
  id                String           @id @default(cuid())
  name              String           @unique
  groupType         CompanyGroupType @map("group_type")
  logo              String?
  primaryColor      String?          @map("primary_color") // hex, örn "#2563eb"
  allowedDomains    Json             @default("[]") @map("allowed_domains") // ["company.com","abc.com.tr"] — email domain kısıtı
  portalDomains     Json             @default("[]") @map("portal_domains") // ["ticket.abc.com.tr"] — erişim domain kilidi
  notificationEmail String?          @map("notification_email") // IT grup maili: it-destek@abc.com.tr
  isActive          Boolean          @default(true) @map("is_active")
  settings          Json             @default("{}")
  /// SLA takvimi, uyarı eşiği ve eskalasyon ayarları. Biçim: `utils/sla-settings.ts`.
  /// Boş → varsayılanlar (7/24 SLA, %80 uyarı, ihlalde yöneticiye bildirim).
  slaSettings       Json?            @map("sla_settings")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  holidays          CompanyHoliday[]
  mailbox           CompanyMailbox?
  webhooks          Webhook[]
  locations         Location[]
  categories        Category[]
  customFields      CustomField[]
  tickets           Ticket[]
  users             User[]
  smtpConfig        CompanySmtp?
  assignedStaff     StaffCompany[]
  credentialEntries CredentialEntry[]

  @@map("companies")
}

/// Şirketin kapalı günleri — mesai takvimi etkinse SLA bu günlerde işlemez.
model CompanyHoliday {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  /// Şirket saat dilimine göre yerel gün.
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@map("company_holidays")
}

/// Şirketin gelen posta kutusu — e-postayla gelen yanıtlar ticket'a not olarak düşer,
/// eşleşmeyen e-postalardan (ayar açıksa) yeni ticket açılır.
model CompanyMailbox {
  id                String          @id @default(cuid())
  companyId         String          @unique @map("company_id")
  provider          MailboxProvider
  /// Posta kutusunun adresi. Talep sahibine giden bildirimlerde Reply-To olarak kullanılır.
  address           String          @unique
  isActive          Boolean         @default(true) @map("is_active")
  // IMAP
  imapHost          String?         @map("imap_host")
  imapPort          Int?            @map("imap_port")
  imapSecure        Boolean         @default(true) @map("imap_secure")
  username          String?
  // Microsoft 365 (Graph, client credentials) / Gmail (OAuth)
  tenantId          String?         @map("tenant_id")
  clientId          String?         @map("client_id")
  /// IMAP parolası / M365 client secret / Google client secret — AES-256-GCM.
  secretEnc         String?         @map("secret_enc")
  /// Gmail OAuth refresh token — AES-256-GCM.
  refreshTokenEnc   String?         @map("refresh_token_enc")
  // Eşleşmeyen e-postalar
  createTickets     Boolean         @default(false) @map("create_tickets")
  defaultCategoryId String?         @map("default_category_id")
  defaultLocationId String?         @map("default_location_id")
  defaultLocale     String          @default("tr") @map("default_locale")
  lastFetchAt       DateTime?       @map("last_fetch_at")
  lastError         String?         @map("last_error")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages InboundMessage[]

  @@map("company_mailboxes")
}

/// İşlenmiş gelen e-postaların kaydı — aynı mesaj iki kez işlenmez (okundu
/// işaretlenemese bile) ve yöneticiye ne olduğu gösterilir.
model InboundMessage {
  id         String   @id @default(cuid())
  mailboxId  String   @map("mailbox_id")
  messageId  String   @map("message_id")
  fromEmail  String   @map("from_email")
  subject    String
  /// reply | created | ignored | failed
  action     String
  reason     String?
  ticketId   String?  @map("ticket_id")
  receivedAt DateTime @default(now()) @map("received_at")

  mailbox CompanyMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, messageId])
  @@index([mailboxId, receivedAt])
  @@map("inbound_messages")
}

model CompanySmtp {
  id        String   @id @default(cuid())
  companyId String   @unique @map("company_id")
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String
  pass      String // AES-256-GCM ile şifreli (CREDENTIALS_ENC_KEY). Bkz. utils/crypto.ts.
  // Şifreleme sonradan eklendi — eski kurulumlarda düz metin
  // kayıtlar olabilir: prisma/scripts/encrypt-smtp-passwords.ts
  fromName  String   @map("from_name") // "ABC IT Destek"
  fromEmail String   @map("from_email") // "it@abc.com"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_smtp")
}

model Location {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  phone     String?
  floor     String?
  itRoom    String?  @map("it_room")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company        Company         @relation(fields: [companyId], references: [id])
  tickets        Ticket[]
  users          User[]
  onsiteSupports OnsiteSupport[]
  tasks          Task[]

  @@unique([companyId, name])
  @@map("locations")
}

// ==================== KATEGORİ (HİYERARŞİK) ====================

model Category {
  id                   String   @id @default(cuid())
  companyId            String?  @map("company_id")
  name                 String
  description          String?
  parentId             String?  @map("parent_id")
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  slaResponseMinutes   Int?     @map("sla_response_minutes")
  slaResolutionMinutes Int?     @map("sla_resolution_minutes")
  autoAssignTo         String?  @map("auto_assign_to")
  createdAt            DateTime @default(now()) @map("created_at")

  company         Company?         @relation(fields: [companyId], references: [id])
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryHierarchy")
  tickets         Ticket[]
  ticketTemplates TicketTemplate[]

  @@map("categories")
}

// ==================== ÖZEL ALANLAR ====================

model CustomField {
  id          String          @id @default(cuid())
  companyId   String?         @map("company_id")
  fieldName   String          @map("field_name")
  fieldLabel  String          @map("field_label")
  fieldType   CustomFieldType @map("field_type")
  options     Json?
  required    Boolean         @default(false)
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  placeholder String?
  createdAt   DateTime        @default(now()) @map("created_at")

  company Company?            @relation(fields: [companyId], references: [id])
  values  TicketCustomValue[]

  @@map("custom_fields")
}

// ==================== KULLANICILAR ====================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  fullName   String   @map("full_name")
  phone      String?
  companyId  String?  @map("company_id")
  locationId String?  @map("location_id")
  department String?
  extraInfo  Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company  Company?  @relation(fields: [companyId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])
  tickets  Ticket[]  @relation("TicketCreator")

  @@map("users")
}

model Staff {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  role         StaffRole
  department   String?
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  avatarUrl    String?   @map("avatar_url")
  mfaSecretEnc String?   @map("mfa_secret_enc")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  // Bildirim (e-posta/SMS) dili. Şablon seçimi bu değere göre yapılır; yoksa 'tr'.
  locale       String    @default("tr")
  /// SSO/dizin ile bağlanmış hesap: sağlayıcı + sağlayıcıdaki kalıcı kimlik (sub / NameID / DN).
  identityProviderId String? @map("identity_provider_id")
  externalSubject    String? @map("external_subject")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assignedTickets   Ticket[]        @relation("TicketAssignee")
  ticketNotes       TicketNote[]
  ticketHistory     TicketHistory[]
  assignedCompanies StaffCompany[]
  createdTasks      Task[]          @relation("TaskCreator")
  taskAssignments   TaskAssignee[]
  taskComments      TaskComment[]   @relation("TaskCommenter")
  watching          TicketWatcher[]
  identityProvider  IdentityProvider? @relation(fields: [identityProviderId], references: [id], onDelete: SetNull)

  @@unique([identityProviderId, externalSubject])
  @@map("staff")
}

model StaffCompany {
  staffId   String @map("staff_id")
  companyId String @map("company_id")

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([staffId, companyId])
  @@map("staff_companies")
}

// ==================== TİCKET SİSTEMİ ====================

model Ticket {
  id                   String       @id @default(cuid())
  ticketNumber         String       @unique @map("ticket_number")
  companyId            String       @map("company_id")
  locationId           String       @map("location_id")
  categoryId           String       @map("category_id")
  createdByEmail       String       @map("created_by_email")
  createdByUserId      String?      @map("created_by_user_id")
  assignedToId         String?      @map("assigned_to_id")
  subject              String
  description          String
  priority             Priority     @default(medium)
  status               TicketStatus @default(open)
  /// Talep sahibinin dili (talep oluştururken yakalanır). Bildirim e-posta/SMS
  /// şablonu bu değere göre seçilir; yoksa 'tr'.
  locale               String       @default("tr")
  accessToken          String       @unique @map("access_token")
  /// Public takip linkinin geçerlilik sonu.
  /// Ticket açıkken null (süresiz); resolved/closed olduğunda kapanış + saklama
  /// süresi olarak set edilir. Link nginx access_log'una, e-postalara ve tarayıcı
  /// geçmişine düştüğü için sonsuza dek geçerli kalmamalı.
  accessTokenExpiresAt DateTime?    @map("access_token_expires_at")
  slaResponseDue       DateTime?    @map("sla_response_due")
  slaResolveDue        DateTime?    @map("sla_resolve_due")
  slaResponseMet       Boolean?     @map("sla_response_met")
  slaResolveMet        Boolean?     @map("sla_resolve_met")
  /// İhlal öncesi uyarı anları. Uyarı gönderilince / hedef tutturulunca null'lanır.
  slaResponseWarnAt    DateTime?    @map("sla_response_warn_at")
  slaResolveWarnAt     DateTime?    @map("sla_resolve_warn_at")
  /// Bekleme durumundayken SLA duraklatılır; çıkışta son tarihler kaydırılır.
  slaPausedAt          DateTime?    @map("sla_paused_at")
  /// Toplam duraklatılmış SLA dakikası (raporlama için).
  slaPausedMinutes     Int          @default(0) @map("sla_paused_minutes")
  /// Son durum değişikliği anı — otomatik kapatma süreleri buradan sayılır.
  statusChangedAt      DateTime?    @map("status_changed_at")
  /// Ticket'ın geldiği kanal: portal | email
  source               String       @default("portal")
  /// Memnuniyet anketi (CSAT): 1–5 puan, isteğe bağlı yorum.
  satisfactionRating   Int?         @map("satisfaction_rating")
  satisfactionComment  String?      @map("satisfaction_comment")
  satisfactionAt       DateTime?    @map("satisfaction_at")
  /// Anket e-postası gönderildi mi (ticket başına bir kez).
  surveySentAt         DateTime?    @map("survey_sent_at")
  /// Üst ticket (yaygın arıza). Tek seviye: üst ticket'ın kendi üstü olamaz.
  parentId             String?      @map("parent_id")
  /// Bu ticket başka bir ticket'a birleştirildiyse hedef.
  mergedIntoId         String?      @map("merged_into_id")
  /// "Kullanıcı yanıtı bekleniyor" hatırlatmasının gönderildiği an (durum değişince sıfırlanır).
  autoCloseReminderAt  DateTime?    @map("auto_close_reminder_at")
  firstRespondedAt     DateTime?    @map("first_responded_at")
  resolvedAt           DateTime?    @map("resolved_at")
  closedAt             DateTime?    @map("closed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id])
  location      Location            @relation(fields: [locationId], references: [id])
  category      Category            @relation(fields: [categoryId], references: [id])
  createdBy     User?               @relation("TicketCreator", fields: [createdByUserId], references: [id])
  assignedTo    Staff?              @relation("TicketAssignee", fields: [assignedToId], references: [id])
  customValues  TicketCustomValue[]
  notes         TicketNote[]
  history       TicketHistory[]
  attachments   Attachment[]
  onsiteSupport OnsiteSupport[]
  notifications Notification[]
  parent        Ticket?             @relation("TicketHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Ticket[]            @relation("TicketHierarchy")
  mergedInto    Ticket?             @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom    Ticket[]            @relation("TicketMerge")
  watchers      TicketWatcher[]

  @@index([status])
  @@index([parentId])
  @@index([status, statusChangedAt])
  @@index([companyId])
  @@index([assignedToId])
  @@index([createdByEmail])
  @@index([createdAt])
  @@map("tickets")
}

model TicketCustomValue {
  id            String @id @default(cuid())
  ticketId      String @map("ticket_id")
  customFieldId String @map("custom_field_id")
  value         String

  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id])

  @@unique([ticketId, customFieldId])
  @@map("ticket_custom_values")
}

model TicketNote {
  id          String   @id @default(cuid())
  ticketId    String   @map("ticket_id")
  content     String
  isInternal  Boolean  @default(false) @map("is_internal")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy Staff  @relation(fields: [createdById], references: [id])

  @@map("ticket_notes")
}

/// Personel girişi için kimlik sağlayıcı (OIDC / SAML 2.0 / LDAP-AD).
/// Tür-özgü ayarlar `config` JSON'unda (biçim: `services/sso/config.ts`); sırlar şifreli.
model IdentityProvider {
  id              String               @id @default(cuid())
  /// URL'de kullanılır: /auth/sso/<slug>/start
  slug            String               @unique
  /// Giriş ekranındaki düğme metni ("Microsoft ile giriş").
  name            String
  type            IdentityProviderType
  isActive        Boolean              @default(true) @map("is_active")
  config          Json                 @default("{}")
  /// OIDC client secret / LDAP bind parolası — AES-256-GCM.
  secretEnc       String?              @map("secret_enc")
  /// Eşleşen rol grubuyla ilk girişte personel kaydı oluştur.
  jitProvisioning Boolean              @default(false) @map("jit_provisioning")
  /// [{ group, role }] — tanımlıysa her girişte rol gruplardan senkronlanır.
  roleMappings    Json                 @default("[]") @map("role_mappings")
  /// [{ group, companyId }] — tanımlıysa her girişte şirket ataması senkronlanır.
  companyMappings Json                 @default("[]") @map("company_mappings")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  staff Staff[]

  @@map("identity_providers")
}

/// Giden webhook / sohbet kanalı. `companyId` boşsa tüm şirketlerin olayları.
/// Hedef URL (Slack/Teams URL'leri yetki anahtarı içerir) ve HMAC sırrı şifrelidir.
model Webhook {
  id              String      @id @default(cuid())
  name            String
  kind            WebhookKind
  urlEnc          String      @map("url_enc")
  /// Genel webhook imza sırrı (HMAC-SHA256) — AES-256-GCM.
  secretEnc       String?     @map("secret_enc")
  /// Abone olunan olaylar: ["ticket.created", "sla.breached", ...]
  events          Json        @default("[]")
  companyId       String?     @map("company_id")
  isActive        Boolean     @default(true) @map("is_active")
  lastDeliveredAt DateTime?   @map("last_delivered_at")
  lastError       String?     @map("last_error")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company    Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

/// Webhook teslimat kaydı (yeniden deneme durumu ve hata ayıklama için).
model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String    @map("webhook_id")
  event       String
  /// Gönderilen olay gövdesi (kanal biçimlendirmesinden önceki genel biçim).
  payload     Json
  /// pending | success | failed
  status      String    @default("pending")
  statusCode  Int?      @map("status_code")
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// Sistem geneli ayarlar (anahtar → JSON). Ör. `auth`: yerel giriş kapalı mı.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Ticket izleyicileri (CC). `staffId` doluysa personel izleyicidir (kullanıcı
/// yanıtlarından haberdar olur); boşsa talep sahibi tarafında CC'dir (talep sahibine
/// giden bildirimleri alır, e-postayla yanıt verebilir).
model TicketWatcher {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  email     String
  staffId   String?  @map("staff_id")
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([ticketId, email])
  @@index([email])
  @@map("ticket_watchers")
}

model TicketHistory {
  id             String   @id @default(cuid())
  ticketId       String   @map("ticket_id")
  action         String
  field          String?
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  createdById    String?  @map("created_by_id")
  createdByEmail String?  @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy Staff? @relation(fields: [createdById], references: [id])

  @@map("ticket_history")
}

model Attachment {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// ==================== YERİNDE DESTEK ====================

model OnsiteSupport {
  id           String       @id @default(cuid())
  ticketId     String       @map("ticket_id")
  locationId   String       @map("location_id")
  type         OnsiteType
  scheduledAt  DateTime     @map("scheduled_at")
  scheduledEnd DateTime?    @map("scheduled_end")
  roomInfo     String?      @map("room_info")
  floorInfo    String?      @map("floor_info")
  notes        String?
  status       OnsiteStatus @default(scheduled)
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  ticket   Ticket   @relation(fields: [ticketId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@map("onsite_support")
}

// ==================== BİLDİRİMLER ====================

model Notification {
  id        String             @id @default(cuid())
  ticketId  String?            @map("ticket_id")
  type      NotificationType
  channel   String // "ticket_created", "status_changed", etc.
  recipient String
  subject   String?
  body      String
  status    NotificationStatus @default(pending)
  errorMsg  String?            @map("error_msg")
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([status])
  @@map("notifications")
}

// ==================== ŞABLONLAR ====================

model TicketTemplate {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  name        String
  subject     String
  description String
  priority    Priority @default(medium)
  createdAt   DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id])

  @@map("ticket_templates")
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("canned_responses")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String
  // Şablon dili. Aynı slug her dil için ayrı satırdır; worker alıcının diline
  // göre seçer, yoksa 'tr'ye düşer.
  locale    String   @default("tr")
  subject   String
  bodyHtml  String   @map("body_html")
  bodyText  String   @map("body_text")
  variables Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@map("email_templates")
}

model SmsTemplate {
  id        String   @id @default(cuid())
  slug      String
  locale    String   @default("tr")
  body      String
  variables Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([slug, locale])
  @@map("sms_templates")
}

// ==================== GÖREVLER (TASKS) ====================

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  priority    Priority   @default(medium)
  status      TaskStatus @default(open)
  dueDate     DateTime?  @map("due_date")
  createdById String     @map("created_by_id")
  locationId  String?    @map("location_id")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  createdBy Staff          @relation("TaskCreator", fields: [createdById], references: [id])
  location  Location?      @relation(fields: [locationId], references: [id])
  assignees TaskAssignee[]
  comments  TaskComment[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([locationId])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id")
  staffId    String   @map("staff_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([taskId, staffId])
  @@map("task_assignees")
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  content     String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy Staff @relation("TaskCommenter", fields: [createdById], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  changes     Json     @default("{}")
  performedBy String   @map("performed_by")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ==================== ŞİFRELER (CREDENTIAL VAULT) ====================

model CredentialEntry {
  id          String   @id @default(cuid())
  companyId   String?  @map("company_id")
  title       String
  category    String?
  url         String?
  username    String?
  passwordEnc String   @map("password_enc")
  notesEnc    String?  @map("notes_enc")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("credential_entries")
}
